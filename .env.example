# OpenAI-compatible generation is optional. Retrieval and evaluation work offline.
LLM_API_KEY=replace_me
LLM_BASE_URL=https://api.example.com/v1
LLM_MODEL=replace_me
LLM_TIMEOUT_SECONDS=30

# Production retrieval configuration.
RAG_MODE=production
RAG_PROJECT_ROOT=
EMBEDDING_BACKEND=bge
BGE_MODEL=BAAI/bge-small-zh-v1.5
BGE_MODEL_PATH=
BGE_DEVICE=cpu
BGE_BATCH_SIZE=16
HF_HOME=models/.cache
USE_TF=0

MILVUS_URI=http://127.0.0.1:19531
MILVUS_COLLECTION=hybrid_rag_public_docs_v1

NEO4J_URI=bolt://127.0.0.1:7688
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace_with_a_long_local_password
NEO4J_NAMESPACE=hybrid-rag-v1

PUBLIC_CORPUS_DIR=data/public_corpus
PUBLIC_EVAL_PATH=data/eval/public_queries.jsonl
PUBLIC_GRAPH_PATH=data/graph/public_relations.json

